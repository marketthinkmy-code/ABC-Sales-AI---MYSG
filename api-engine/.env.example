# 複製成 .env 再填。.env 已被 .gitignore 擋住，不會進 git。
# 拿 token 步驟見 api-engine/TOKEN-SETUP.md

# --- Meta App / Token (必填) ---
META_APP_ID=
META_APP_SECRET=
# System User 的長期 token，需有 ads_management 權限、且能存取下面這個帳號
META_ACCESS_TOKEN=

# --- 目標帳號：AI 回覆 幫你獲客 (TWD) ---
AD_ACCOUNT_ID=1984262458861966
PAGE_ID=
INSTAGRAM_ID=
PIXEL_ID=
CURRENCY=TWD

# --- 漏斗設定 ---
# Soo Cheng 用 OUTCOME_SALES + 網站報名。此帳號若是「AI 回覆獲客」(Messenger/名單)，
# 可改 OUTCOME_LEADS。轉換事件對應改。
OBJECTIVE=OUTCOME_SALES
CONVERSION_EVENT=CompleteRegistration
LANDING_URL=

# --- 優化門檻 (TWD)。目標 CPA 180，可接受到 240 ---
TARGET_CPL=180          # 目標每次成果成本
KILL_CPL=240            # 高於此關掉 (可接受上限)
SCALE_CPL=180           # 低於此加碼
BUDGET_STEP_PCT=20      # 加碼幅度 %
MAX_DAILY_BUDGET=2600   # 單組每日預算上限
MIN_SPEND_BEFORE_ACTION=180  # 未花到此不判死 (約 1×target)
DRY_RUN=true            # true=只印建議不動手；驗證後改 false
