# 複製成 .env 再填。.env 已被 .gitignore 擋住,不會進 git。
# 帳號/pixel/落地頁/門檻等「非機密」值放 config/markets.yaml,不用在這裡填。
# 這裡只放機密 + 選擇市場。拿 token 步驟見 api-engine/TOKEN-SETUP.md

# --- 選擇市場 (MY / SG) ---
MARKET=MY

# --- Meta App / Token (必填) ---
META_APP_ID=
META_APP_SECRET=
# System User 長期 token,需有 ads_management 且能存取 MY(384734236863395)+ SG(536941169394673) 兩個帳號
META_ACCESS_TOKEN=

# --- Google / AI (video-pipeline / creative-pipeline / weekly CPA 用) ---
# 服務帳號 JSON(整包貼進來)。要把它的 client_email 共享進:
#   1) Drive 素材資料夾  2) 買單 Sheet
GOOGLE_SA_JSON=
ANTHROPIC_API_KEY=
# 直接放 mp4 的「待上架」資料夾 id(video-pipeline)
DRIVE_VIDEO_FOLDER_ID=
# 直接放圖的資料夾 id(creative-pipeline,選用)
DRIVE_IMAGE_FOLDER_ID=

# --- 每週 CPA 戰報 ---
BUYER_SHEET_ID=1cXHt9sycxKlYfv8DjeOESQyAZSvz8PSlCVBDxNMBMvg
PRICE_PER_SALE=          # 客單價(後端課程售價,MYR)。ROAS 要用

# --- 安全閘 ---
# true = 只印建議 / 只試跑,不動任何廣告。核對 3-5 天無誤才改 false。
DRY_RUN=true

# --- (選用) 覆蓋 markets.yaml 的門檻。留空就用 markets.yaml ---
# TARGET_CPL=
# SCALE_CPL=
# MID_SCALE_MAX=
# KILL_CPL=
# CPA_KILL=
# MAX_DAILY_BUDGET=
# START_DAILY_BUDGET=
# MIN_SPEND_BEFORE_ACTION=
